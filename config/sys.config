%-*-Erlang-*-
[{chf, [
    %% Cluster peer nodes. Empty list = single-node deployment (cluster_nodes/0
    %% always adds the local node via usort, so [] → [self]).
    %% For multi-node, list ALL cluster members (including this node) identically
    %% on every node.  Charging requires a strict majority to be reachable.
    %% See docs/clustering.md for cold-start ordering and partition-heal procedure.
    {cluster_nodes, []}
    %% Example 3-node cluster (uncomment and adapt on every node):
    %% {cluster_nodes, ['chf@10.0.0.1', 'chf@10.0.0.2', 'chf@10.0.0.3']}
  ]},

 {chf_db, [
    {backend, chf_db_mnesia}
    %% To use the MongoDB backend instead of Mnesia, replace the block above with:
    %% {backend, chf_db_mongo},
    %% {mongo, #{
    %%     host      => "127.0.0.1",
    %%     port      => 27017,
    %%     replset   => <<"rs0">>,
    %%     database  => <<"chf">>,
    %%     pool_size => 10
    %% }}
  ]},

 {chf_core, [
    {session_idle_timeout, 300000},  %% 5 minutes
    {default_quota, 10000000}  %% micro-units; per-RG grant ceiling (chf_online module) when no subscriber quota configured
  ]},

 {chf_diameter, [
    {origin_host, "chf.epc.mnc001.mcc001.3gppnetwork.org"},
    {origin_realm, "epc.mnc001.mcc001.3gppnetwork.org"},
    {listen, [{tcp, {127,0,0,1}, 3868}]},
    {validity_time, 3600}  %% seconds; Gy MSCC Validity-Time
  ]},

 {chf_sbi, [
    {port, 8443},
    {ip, {127,0,0,1}},
    {validity_time, 3600}  %% seconds; SBI multipleUnitInformation validityTime
  ]},

 {chf_api, [
    {port, 8080},
    {ip, {127,0,0,1}}
  ]},

 {chf_web, [
    {port, 8081},
    {ip, {127,0,0,1}}
  ]},

 {opentelemetry, [
    {span_processor, batch},
    {traces_exporter, none},
    {resource, #{service => #{name => <<"chf">>}}}
  ]},

 {opentelemetry_exporter, [
    {otlp_protocol, http_protobuf},
    {otlp_endpoint, "http://localhost:4318"}
  ]},

 {opentelemetry_experimental, [
    {readers, [
      %% OTLP push reader: attach the OTLP exporter (it uses the endpoint/protocol
      %% from the {opentelemetry_exporter, ...} block above) and a push interval.
      %% Without an `exporter` key the reader collects but never exports (no-op).
      #{module => otel_metric_reader,
        config => #{exporter => {opentelemetry_exporter, #{}},
                    export_interval_ms => 10000}},
      #{module => otel_metric_reader_prometheus, config => #{server_name => otel_prometheus_reader}}
    ]}
  ]},

 {kernel, [
    {logger, [
        {handler, default, logger_std_h,
            #{level => info,
              config =>
                  #{sync_mode_qlen => 10000,
                    drop_mode_qlen => 10000,
                    flush_qlen     => 10000}
            }
        }
    ]}
  ]}
].
