%-*-Erlang-*-
%% CT / common-test sys.config.
%%
%% Identical to config/sys.config except the chf_db backend storage tier is
%% forced to ram_copies so common_test runs never touch disc. Individual CT
%% suites that manage their own Mnesia setup also set backend_opts explicitly;
%% this file is the default for any suite (or `rebar3 ct --sys_config`) that does
%% not.
[{chf, [
    {cluster_nodes, []}
  ]},

 {chf_db, [
    {backend, chf_db_mnesia},
    {backend_opts, #{storage => ram_copies}}
  ]},

 {chf_core, [
    {session_idle_timeout, 300000},
    {default_quota, 10000000}
  ]},

 {kernel, [
    {logger, [
        {handler, default, logger_std_h,
            #{level => warning}
        }
    ]}
  ]}
].
