%-*-Erlang-*-
%% The Diameter codec modules (diameter_*.erl in src/, diameter_*.hrl in
%% include/) are NOT checked into the repo. They are generated from the .dia
%% sources in dia/ on every build by gen_dict.sh (which drives OTP's own
%% diameter_make:codec/2) and are gitignored. The third-party
%% rebar3_diameter_compiler plugin was removed: it does not load on OTP 29 (its
%% clean_diameter.erl uses a bare `catch`, now a hard error).
%%
%% gen_dict.sh self-locates (cd "$(dirname "$0")"), so the compile hook (CWD =
%% this app dir) passes "sh gen_dict.sh" while eunit/ct (CWD = project root)
%% pass the full path. The clean post_hook removes the generated artifacts.
%% rebar3 runs hooks via open_port (no shell operators/globs), so all multi-step
%% logic lives in the script, invoked as a single command. See gen_dict.sh.
{erl_opts, [debug_info]}.

{pre_hooks, [
    {compile, "sh gen_dict.sh"},
    {eunit,   "sh apps/chf_diameter/gen_dict.sh"},
    {ct,      "sh apps/chf_diameter/gen_dict.sh"}
]}.

{post_hooks, [
    {clean, "sh gen_dict.sh clean"}
]}.
